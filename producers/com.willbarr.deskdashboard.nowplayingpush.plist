<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.willbarr.deskdashboard.nowplayingpush</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/willbarr/Developer/DeskDashboard/producers/now-playing-push.py</string>
    </array>

    <!-- Poll every 5s. The widget advances elapsed on its own between pushes,
         so this only needs to be frequent enough to catch track/state changes. -->
    <key>StartInterval</key>
    <integer>5</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Override defaults per machine without editing the script, e.g. the
         HomePod id on the Mac mini or a non-local ingest host. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DD_ATV_ID</key>
        <string>B2C043882063</string>
        <key>DD_INGEST_URL</key>
        <string>http://127.0.0.1:8642/ingest/now-playing</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/deskdashboard-nowplaying.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/deskdashboard-nowplaying.err</string>
</dict>
</plist>
